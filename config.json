        "tag": "dns_proxy",
        "detour": "shadowsocks-out",
        "server": "8.8.8.8"
      }
    ],
    "rules": [
      {
        "query_type": [
          "AAAA"
        ],
        "action": "reject"
      },
      {
        "rule_set": "cn_domain",
