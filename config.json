    },
    {
      "type": "mixed",
      "listen": "127.0.0.1",
      "listen_port": 7890
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "shadowsocks-out",
      "server": "219.78.209.216",
      "server_port": 21016,
      "method": "2022-blake3-aes-128-gcm",
      "password": "0D7fg1018lIoXdXhM3eOBQ=="
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
