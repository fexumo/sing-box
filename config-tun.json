{
  "log": {
    "level": "error",
    "disabled": false
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "8.8.4.4",
        "tls": {
          "enabled": true
        },
        "detour": "proxy"
      },
      {
        "tag": "dns-local",
        "type": "h3",
        "server": "223.5.5.5",
        "tls": {
          "enabled": true
        }
      }
    ],
    "rules": [
      {
        "rule_set": ["cn-location", "cn-site"],
        "server": "dns-local"
      }
    ],
    "optimistic": {
      "enabled": true
    }
  },
  "http_clients": [
    {
      "tag": "go"
    }
  ],
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.19.0.1/30", "fdfe:dcba:9876::1/126"],
      "auto_route": true,
      "strict_route": true,
      "route_exclude_address_set": ["cn-ip"],
      "stack": "system"
    }
  ],
  "outbounds": [
    {
      "type": "shadowsocks",
      "tag": "proxy",
      "server": "dbd93d58-hkt3.uzuma.ru",
      "server_port": 21016,
      "method": "2022-blake3-aes-128-gcm",
      "password": "18D7fg1048lIoXdXhM3eOBQ=="
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "route": {
    "rules": [
      {
        "network": ["icmp"],
        "outbound": "direct"
